{
  "title": "DeepFeed AI - System Health",
  "uid": "deepfeed-system",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API Requests/min",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(deepfeed_http_requests_total[1m]) * 60", "legendFormat": "req/min" }]
    },
    {
      "id": 2, "type": "stat", "title": "Items Discovered (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "increase(deepfeed_items_discovered_total[24h])", "legendFormat": "items" }]
    },
    {
      "id": 3, "type": "stat", "title": "Recommendations Generated (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "increase(deepfeed_recommendations_generated_total[1h])", "legendFormat": "recs" }]
    },
    {
      "id": 4, "type": "stat", "title": "LLM Tokens Used (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "increase(deepfeed_llm_tokens_used_total[1h])", "legendFormat": "tokens" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "API Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "rate(deepfeed_http_requests_total{status=~\"5..\"}[5m]) / rate(deepfeed_http_requests_total[5m])",
        "legendFormat": "5xx rate"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Discovery Jobs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "rate(deepfeed_discovery_jobs_total[5m])", "legendFormat": "jobs/s" },
        { "expr": "rate(deepfeed_provider_failures_total[5m])", "legendFormat": "failures/s" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Adaptation Events",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "expr": "rate(deepfeed_adaptation_events_total[5m])",
        "legendFormat": "{{ agent_name }}"
      }]
    },
    {
      "id": 8, "type": "timeseries", "title": "LLM Request Latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(deepfeed_llm_request_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 {{ provider }}"
      }]
    }
  ]
}
