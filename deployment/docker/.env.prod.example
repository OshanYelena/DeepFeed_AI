# DeepFeed AI - Production compose variables (EC2)
#
# Copy this to deployment/docker/.env on the EC2 instance and fill in real
# values. This file is read automatically by `docker compose` (same
# directory as docker-compose.prod.yml) for ${VAR} substitution — it is
# separate from apps/backend/.env, which still holds the app's own secrets
# (JWT_SECRET_KEY, LLM API keys, etc.) via env_file:.
#
# Never commit the real .env — it's already covered by the root .gitignore.

# Must match the GHCR namespace the CD workflow pushes to — your GitHub
# username or org, lowercase.
GHCR_OWNER=oshanyelena

# Which image tag to run. The CD workflow pushes both `latest` and the git
# SHA on every deploy; pin to a SHA here if you ever want to roll back
# without waiting on a new push.
IMAGE_TAG=latest

# Real passwords — generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
